<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OrbisFX Matches-Differs Pro</title>
<style>
:root {
  color-scheme: dark;
  --bg: #080d17;
  --panel: #111b2b;
  --border: #26364d;
  --text: #edf4ff;
  --muted: #91a4bd;
  --blue: #38bdf8;
  --green: #35d49a;
  --red: #fb7185;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 20px 14px 36px;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, sans-serif;
}
main { max-width: 850px; margin: auto; }
header { margin-bottom: 20px; }
.brand { color: var(--blue); font-weight: bold; letter-spacing: 2px; }
h1 { font-size: 27px; margin: 8px 0; }
.subtitle, .muted { color: var(--muted); font-size: 13px; line-height: 1.5; }
.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 14px;
}
.row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
label { display: block; color: var(--muted); font-size: 12px; margin-bottom: 7px; }
select, button {
  border-radius: 9px;
  border: 1px solid var(--border);
  background: #0b1422;
  color: var(--text);
  padding: 12px;
  font-size: 14px;
}
select { width: 100%; }
button { cursor: pointer; font-weight: bold; }
button.primary { background: var(--blue); color: #06111b; border-color: var(--blue); }
button:disabled { opacity: .5; cursor: default; }
.field { flex: 1; min-width: 135px; }
.status { display: flex; align-items: center; gap: 8px; font-size: 13px; }
.dot { width: 9px; height: 9px; border-radius: 50%; background: #fbbf24; }
.dot.on { background: var(--green); }
.dot.off { background: var(--red); }
.price { font-size: clamp(25px, 7vw, 38px); font-weight: bold; margin: 8px 0; overflow-wrap: anywhere; }
.big-digit { color: var(--blue); font-size: 52px; font-weight: bold; }
.metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.metric { background: #0b1422; padding: 12px; border-radius: 10px; }
.metric span { display: block; color: var(--muted); font-size: 12px; }
.metric strong { display: block; font-size: 22px; margin-top: 6px; }
.digits { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
.digit {
  text-align: center; background: #0b1422; border: 1px solid var(--border);
  padding: 10px 2px; border-radius: 9px;
}
.digit strong { display: block; font-size: 19px; }
.digit small { display: block; color: var(--muted); margin-top: 5px; font-size: 10px; }
.bar { height: 4px; background: #26364d; margin-top: 8px; border-radius: 5px; overflow: hidden; }
.fill { height: 100%; background: var(--blue); width: 0%; }
.history { display: flex; gap: 7px; flex-wrap: wrap; }
.tick {
  border: 1px solid var(--border); background: #0b1422;
  border-radius: 7px; padding: 8px; min-width: 35px; text-align: center;
}
small, .tiny { color: var(--muted); font-size: 11px; }
.error { color: var(--red); }
.notice { color: var(--muted); font-size: 12px; line-height: 1.6; }
@media(min-width:600px) { .metrics { grid-template-columns: repeat(4, 1fr); } }
</style>
</head>
<body>
<main>
<header>
  <div class="brand">ORBISFX</div>
  <h1>Matches-Differs Pro</h1>
  <div class="subtitle">Deriv live tick statistics · Volatility Indices</div>
</header>

<section class="card">
  <div class="status"><span id="dot" class="dot"></span><span id="status">Not connected</span></div>
  <p id="detail" class="muted">Connect to begin collecting live ticks.</p>
  <div class="row">
    <div class="field">
      <label for="market">Volatility market</label>
      <select id="market">
        <option value="R_10">Volatility 10 Index</option>
        <option value="R_25">Volatility 25 Index</option>
        <option value="R_50">Volatility 50 Index</option>
        <option value="R_75" selected>Volatility 75 Index</option>
        <option value="R_100">Volatility 100 Index</option>
        <option value="1HZ10V">Volatility 10 (1s) Index</option>
        <option value="1HZ25V">Volatility 25 (1s) Index</option>
        <option value="1HZ50V">Volatility 50 (1s) Index</option>
        <option value="1HZ75V">Volatility 75 (1s) Index</option>
        <option value="1HZ100V">Volatility 100 (1s) Index</option>
      </select>
    </div>
    <div class="field">
      <label for="appId">Deriv App ID (numeric)</label>
      <input id="appId" type="number" inputmode="numeric" placeholder="Enter your App ID"
        style="width:100%;padding:12px;border-radius:9px;border:1px solid var(--border);background:#0b1422;color:white">
    </div>
  </div>
  <div class="row" style="margin-top:12px">
    <button class="primary" id="connect">Connect live ticks</button>
    <button id="disconnect">Disconnect</button>
  </div>
  <p class="tiny">This app uses public market tick data. Never enter your account password or API token here.</p>
</section>

<section class="card">
  <label>LIVE MARKET PRICE</label>
  <div id="price" class="price">—</div>
  <div class="row">
    <div><span class="muted">Latest digit</span><div id="lastDigit" class="big-digit">—</div></div>
    <div style="flex:1"><span class="muted">Ticks collected</span><div id="tickCount" style="font-size:24px;margin-top:10px">0</div></div>
  </div>
</section>

<section class="card">
  <h3>Matches & Differs Analysis</h3>
  <div class="row">
    <div class="field">
      <label for="target">Target digit</label>
      <select id="target">
        <option>0</option><option>1</option><option>2</option><option>3</option>
        <option>4</option><option>5</option><option>6</option><option>7</option>
        <option>8</option><option>9</option>
      </select>
    </div>
    <div class="field">
      <label>Observation window</label>
      <select id="window">
        <option value="100">Last 100 ticks</option>
        <option value="250">Last 250 ticks</option>
        <option value="500">Last 500 ticks</option>
        <option value="1000">Last 1000 ticks</option>
      </select>
    </div>
  </div>
  <div class="metrics" style="margin-top:14px">
    <div class="metric"><span>Matches observed</span><strong id="matches">0</strong></div>
    <div class="metric"><span>Matches frequency</span><strong id="matchPct">—</strong></div>
    <div class="metric"><span>Differs observed</span><strong id="differs">0</strong></div>
    <div class="metric"><span>Differs frequency</span><strong id="differPct">—</strong></div>
  </div>
  <p class="notice">These figures describe collected historical ticks, not the probability of the next tick. They are not guaranteed trading signals.</p>
</section>

<section class="card">
  <h3>Digit Frequency</h3>
  <p class="muted">Distribution within the selected observation window.</p>
  <div id="digits" class="digits"></div>
</section>

<section class="card">
  <h3>Recent Tick History</h3>
  <div id="history" class="history"><span class="muted">Waiting for live ticks…</span></div>
</section>

<section class="card">
  <h3>Connection Diagnostics</h3>
  <div class="metrics">
    <div class="metric"><span>WebSocket</span><strong id="socketState">Closed</strong></div>
    <div class="metric"><span>Last tick time</span><strong id="lastTime" style="font-size:14px">—</strong></div>
  </div>
  <p id="diagnostic" class="notice">Enter your registered Deriv App ID and connect.</p>
</section>
<div class="tiny" style="text-align:center">OrbisFX · Independent statistics tool · Not financial advice</div>
</main>

<script>
(() => {
  const $ = id => document.getElementById(id);
  let socket = null, ticks = [], reconnectTimer = null, manuallyClosed = false;
  const MAX_TICKS = 2000;

  function setStatus(message, state, detail = "") {
    $("status").textContent = message;
    $("dot").className = "dot " + (state || "");
    $("detail").textContent = detail;
    $("socketState").textContent = state === "on" ? "Open" : state === "off" ? "Closed" : "Connecting";
  }

  function closeSocket(manual = false) {
    manuallyClosed = manual;
    if (reconnectTimer) clearTimeout(reconnectTimer);
    reconnectTimer = null;
    if (socket) {
      const old = socket;
      socket = null;
      old.onclose = null;
      old.onerror = null;
      try { old.close(); } catch (_) {}
    }
    if (manual) setStatus("Disconnected", "off", "Connection closed by you.");
  }

  function connect() {
    closeSocket(false);
    const appId = $("appId").value.trim();
    if (!/^\d+$/.test(appId) || Number(appId) <= 0) {
      setStatus("App ID required", "off", "Enter the numeric App ID from your Deriv developer app settings.");
      $("diagnostic").textContent = "Check that the App ID contains numbers only. Do not enter an API token.";
      return;
    }
    manuallyClosed = false;
    setStatus("Connecting…", "", "Opening secure connection to Deriv.");
    $("diagnostic").textContent = "Trying to open a WebSocket connection.";
    let ws;
    try {
      ws = new WebSocket("wss://ws.derivws.com/websockets/v3?app_id=" + encodeURIComponent(appId));
      socket = ws;
    } catch (e) {
      setStatus("Connection failed", "off", e.message || "Could not create WebSocket.");
      $("diagnostic").textContent = "Check your internet connection and App ID, then try again.";
      return;
    }
    ws.onopen = () => {
      if (socket !== ws) return;
      setStatus("Connected — subscribing", "on", "WebSocket opened. Requesting ticks.");
      $("diagnostic").textContent = "Connection opened; waiting for Deriv tick subscription response.";
      ws.send(JSON.stringify({ ticks: $("market").value, subscribe: 1 }));
    };
    ws.onmessage = event => {
      if (socket !== ws) return;
      let data;
      try { data = JSON.parse(event.data); } catch (_) { return; }
      if (data.error) {
        setStatus("Deriv API error", "off", data.error.message || "Request rejected.");
        $("diagnostic").textContent = "API error code: " + (data.error.code || "unknown") + ". Check the App ID and selected market.";
        return;
      }
      if (data.msg_type === "tick" && data.tick) {
        const quote = String(data.tick.quote);
        const digitMatch = quote.match(/(\d)$/);
        if (!digitMatch) return;
        const digit = Number(digitMatch[1]);
        ticks.push({ quote, digit, epoch: data.tick.epoch });
        if (ticks.length > MAX_TICKS) ticks.shift();
        $("price").textContent = quote;
        $("lastDigit").textContent = digit;
        $("tickCount").textContent = ticks.length;
        $("lastTime").textContent = new Date(data.tick.epoch * 1000).toLocaleTimeString();
        setStatus("Live ticks received", "on", "Market: " + $("market").selectedOptions[0].text);
        $("diagnostic").textContent = "Last tick received successfully. Tick history updates as new prices arrive.";
        render();
      }
    };
    ws.onerror = () => {
      if (socket !== ws) return;
      setStatus("Connection error", "off", "The WebSocket encountered an error.");
      $("diagnostic").textContent = "Check network access, App ID, and whether your browser allows WebSocket connections.";
    };
    ws.onclose = event => {
      if (socket !== ws) return;
      socket = null;
      if (manuallyClosed) return;
      setStatus("Connection closed", "off", "The Deriv connection closed.");
      $("diagnostic").textContent = "Close code: " + event.code + ". Tap Connect live ticks to retry.";
    };
  }

  function render() {
    const limit = Number($("window").value);
    const sample = ticks.slice(-limit);
    const total = sample.length;
    const target = Number($("target").value);
    const matches = sample.filter(t => t.digit === target).length;
    const differs = total - matches;
    $("matches").textContent = matches;
    $("differs").textContent = differs;
    $("matchPct").textContent = total ? (matches / total * 100).toFixed(1) + "%" : "—";
    $("differPct").textContent = total ? (differs / total * 100).toFixed(1) + "%" : "—";

    const counts = Array(10).fill(0);
    sample.forEach(t => counts[t.digit]++);
    $("digits").innerHTML = counts.map((count, digit) => {
      const pct = total ? count / total * 100 : 0;
      return `<div class="digit"><strong>${digit}</strong><small>${count} · ${pct.toFixed(1)}%</small><div class="bar"><div class="fill" style="width:${pct}%"></div></div></div>`;
    }).join("");

    const recent = ticks.slice(-30).reverse();
    $("history").innerHTML = recent.length
      ? recent.map(t => `<div class="tick" title="${new Date(t.epoch * 1000).toLocaleTimeString()}"><strong>${t.digit}</strong><br><small>${t.quote}</small></div>`).join("")
      : '<span class="muted">Waiting for live ticks…</span>';
  }

  $("connect").addEventListener("click", connect);
  $("disconnect").addEventListener("click", () => closeSocket(true));
  $("market").addEventListener("change", () => { if (socket && socket.readyState === WebSocket.OPEN) connect(); });
  $("target").addEventListener("change", render);
  $("window").addEventListener("change", render);
  render();
})();
</script>
</body>
  </html>
